# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/astracare_db
# For local development (SQLite fallback):
# DATABASE_URL=sqlite:///./astracare_dev.db

# Supabase (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# AI/LLM API (optional - system works without it)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# App Config
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Simulation
SIMULATION_INTERVAL_SECONDS=30
